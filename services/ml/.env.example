# Шаблон настроек окружения. Скопируйте в .env и заполните.
# Параметры алгоритмов — в config/ml.toml, здесь только то, что зависит от машины.

# --- пути (относительные — от корня проекта) ---
# REC_NEWS_DATA_DIR=data
# REC_NEWS_MODELS_DIR=models
# REC_NEWS_DATASET_DIR=dataset

# --- эмбеддинги ---
# REC_NEWS_EMBEDDING_MODEL=deepvk/USER-bge-m3

# --- LLM: OpenAI-совместимый API ---
# Разработка: LM Studio, http://127.0.0.1:1234/v1. Хакатон: адрес и ключ организаторов.
REC_NEWS_LLM_BASE_URL=http://127.0.0.1:1234/v1
REC_NEWS_LLM_API_KEY=
# Модель по умолчанию для всех задач; пусто — первая модель из GET /models.
REC_NEWS_LLM_MODEL=
REC_NEWS_LLM_TIMEOUT_S=180
REC_NEWS_LLM_TEMPERATURE=0
# 0 — работать без LLM
# REC_NEWS_USE_LLM=1

# --- модели хакатона по задачам (один ключ API) ---
# Имена — как их отдаёт GET {BASE_URL}/models. Пусто — REC_NEWS_LLM_MODEL.
# Какая задача в какой класс идёт — [llm_tasks] в config/ml.toml.
# Gemma 4 26B A4B: темы новостей, дедуп «то же событие?», реранк ленты
REC_NEWS_LLM_MODEL_LIGHT=
# GLM-5.3-Flash: инсайт «что это значит для вашей компании»
REC_NEWS_LLM_MODEL_REASONING=
# Qwen3.6 35B A3B: аспекты профиля, задачи без явного класса
REC_NEWS_LLM_MODEL_UNIVERSAL=
# DeepSeek-V4.1-Flash: LLM-судья связи новости с аналитикой
REC_NEWS_LLM_MODEL_RELATIONS=
# Qwen3-VL-30B-A3B-Instruct: изображения (зарезервирована)
REC_NEWS_LLM_MODEL_VISION=
# Kimi-K2.6: связка «новость ↔ аналитика», генерация синтетических новостей
REC_NEWS_LLM_MODEL_TEXT=

# --- агент ---
# Сколько разделов ответа писать одновременно. LM Studio делит контекст модели
# между параллельными запросами: при контексте 8192 ставьте 1–2.
# REC_NEWS_AGENT_PARALLEL_WRITERS=4
# Сколько агентов блоков карточки инсайта работают одновременно внутри этапа.
# REC_NEWS_INSIGHT_PARALLEL_BLOCKS=3
# Сколько карточек строится одновременно в задании POST /users/{id}/insights/generate.
# REC_NEWS_INSIGHT_WORKERS=2

# --- Qdrant ---
# Адрес Qdrant-сервера. Пусто — локальная база data/qdrant (её открывает только один процесс).
# Нужен, когда обработку выполняют воркеры Celery отдельно от API.
# REC_NEWS_QDRANT_URL=http://127.0.0.1:6333
# REC_NEWS_QDRANT_API_KEY=

# --- API ---
# REC_NEWS_API_HOST=127.0.0.1
# REC_NEWS_API_PORT=8000
