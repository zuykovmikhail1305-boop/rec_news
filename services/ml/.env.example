REC_NEWS_LLM_API_KEY=свой ключ 
REC_NEWS_LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Модели по задачам — уже заданы в коде (news_pipeline/config.py), менять не нужно.

# Разделы ответа агента пишутся параллельно.
REC_NEWS_AGENT_PARALLEL_WRITERS=4

# «Сейчас» для демо: синтетические новости идут до 21.10.2026.
REC_NEWS_DEMO_NOW=2026-10-21T18:00:00

# --- для локальной разработки через LM Studio раскомментируйте ---
# REC_NEWS_LLM_BASE_URL=http://127.0.0.1:1234/v1
# REC_NEWS_LLM_MODEL=qwen3-8b
# REC_NEWS_AGENT_PARALLEL_WRITERS=1

# Модели хакатона по классам задач (распределение — [llm_tasks] в config/ml.toml)
REC_NEWS_LLM_MODEL_LIGHT=google/gemma-4-26b-a4b-it
REC_NEWS_LLM_MODEL_REASONING=z-ai/glm-5.3-flash
REC_NEWS_LLM_MODEL_UNIVERSAL=qwen/qwen3.6-35b-a3b
REC_NEWS_LLM_MODEL_RELATIONS=deepseek/deepseek-v4.1-flash
REC_NEWS_LLM_MODEL_VISION=qwen/qwen3-vl-30b-a3b-instruct
REC_NEWS_LLM_MODEL_TEXT=moonshotai/kimi-k2.6

# --- локальные модели (работают на этой машине, без API) ---
REC_NEWS_MODELS_DIR=models
REC_NEWS_EMBEDDING_MODEL=deepvk/USER-bge-m3
REC_NEWS_OCR_LANGUAGES=ru,en
REC_NEWS_OCR_GPU=0