# All processes must load the same file: uv run --env-file .env ...
PARSER_API_HOST=127.0.0.1
PARSER_API_PORT=8001
PARSER_QUEUE_BACKEND=celery
PARSER_BROKER_URL=amqp://parser:parser_local@127.0.0.1:5672/rec_news

# Shared PostgreSQL database. Replace placeholders before enabling this line.
# PARSER_DATABASE_URL=postgresql+psycopg://parser_user:password@127.0.0.1:5432/rec_news
# Docker Compose: use the database service hostname (e.g. db), not 127.0.0.1.
# A common DATABASE_URL or REC_NEWS_DATABASE_URL is also accepted when PARSER_DATABASE_URL is absent.
PARSER_DATABASE_SCHEMA=public
# PostgreSQL defaults to exporting ready publications into the ML-owned input table.
# PARSER_ML_EXPORT_ENABLED=true
PARSER_ML_NEWS_SCHEMA=ml_news
# Initialize ml_news.news using ML migrations/init_db before starting the parser.
PARSER_DB_POOL_SIZE=5
PARSER_DB_MAX_OVERFLOW=10
PARSER_DB_POOL_TIMEOUT=30
PARSER_DB_CONNECT_TIMEOUT=10
# PostgreSQL defaults to false; initialize once with scripts/init_db.py before startup.
# PARSER_AUTO_CREATE_TABLES=false
# Explicit SQLite fallback for local development:
# PARSER_DATABASE_URL=sqlite:///D:/repos/rec_news/services/parser/parser_app/parser.db

# RSS discovery: Beat -> parser.poll_rss -> existing publication queue.
PARSER_RSS_ENABLED=false
PARSER_RSS_INTERVAL=300
PARSER_RSS_LIMIT=100
PARSER_RSS_TIMEOUT=15
PARSER_RSS_SOURCES={"interfax":"https://www.interfax.ru/rss.asp"}
PARSER_RSS_BACKOFF_MAX=3600
